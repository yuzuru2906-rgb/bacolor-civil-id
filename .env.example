# Copy this file to ".env" for local development. NEVER upload your real .env to GitHub.

# Leave empty to use a local SQLite file (easy for testing on your own computer).
# On the internet, paste your Neon connection string here (see README).
DATABASE_URL=

# The main administrator. Choose your own strong password!
ADMIN_USERNAME=admin
ADMIN_NAME=Registry Admin
ADMIN_PASSWORD=

# A secret code that new staff must type on the "Admin Register" tab.
# Leave empty to turn staff self-registration OFF completely.
ADMIN_SIGNUP_CODE=

# true  = a resident who uploads everything is verified automatically (how the original website worked)
# false = every resident waits for a staff member to verify them (safer)
AUTO_VERIFY=true

# The "Forgot password" page confirms a resident with their date of birth only.
# Set to false to turn it off until SMS / email codes are added.
ALLOW_DOB_PASSWORD_RESET=true
